        "metric": "avg_daily_yield_per_cow",
        "definition": "Average litres one cow gives in one day (AM+PM). Computed as total litres divided by cow-days at the cow-day grain \u2014 never by summing per-cow averages.",
        "owner": "data-designer",
        "version": "v1",
        "aggregation": "derived",
        "class": "derived",
        "lineage": [
          "gold.agg_milk_cow_daily",
          "silver.milk_logs",
          "silver.cows"
        ],
        "sql": "SELECT sum(\"litres\")*1.0/nullif(count(*),0) AS \"avg_daily_yield_per_cow\" FROM \"agg_milk_cow_daily\"",
        "note": "additive"
      }
