{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "aina-out/barnboard/app/app/**",
          "aina-out/barnboard/app/templates/**",
          "aina-out/barnboard/app/static/**",
          "betadoc-data/site/**",
          "models/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
