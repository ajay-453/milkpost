      "metric": "milk_revenue",
      "label": "Milk sales revenue",
      "description": "Rupees received for milk: sum of litres times price per litre across collections. Additive in rupee terms; computed from components, never from a pre-averaged price.",
      "aggregation": "derived",
      "expression": "sum(\"litres\"*\"price_per_litre\")",
