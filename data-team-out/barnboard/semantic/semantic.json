    {
      "metric": "avg_daily_yield_per_cow",
      "label": "Avg daily yield per cow",
      "description": "Average litres one cow gives in one day (AM+PM). Computed as total litres divided by cow-days at the cow-day grain — never by summing per-cow averages.",
      "aggregation": "derived",
      "expression": "sum(\"litres\")*1.0/nullif(count(*),0)",
      "dimensions": [],
      "time_grains": [
        "daily",
        "weekly",
        "monthly"
      ],
      "rollups": {
        "daily": "gold.agg_milk_cow_daily"
      },
