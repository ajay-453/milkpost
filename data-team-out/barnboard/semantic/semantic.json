    {
      "metric": "price_per_litre",
      "label": "Avg price per litre",
      "description": "Volume-weighted average rupees per litre: total revenue divided by total litres. AUTHORED OVERRIDE of the auto-proposed sum — a price is a ratio and must be recomputed, never summed (the governance guard exists for exactly this).",
      "aggregation": "derived",
      "expression": "sum(\"litres\"*\"price_per_litre\")*1.0/nullif(sum(\"litres\"),0)",
